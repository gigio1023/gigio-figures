{
  "schema_version": 2,
  "units": {
    "u": "SVG user unit. A default figure is 720u wide; in a Notion or blog column of about 704-720 CSS px, 1u is about 1 CSS px, and the 2x PNG export has 2 px per u.",
    "canvas_width_u": 720,
    "wide_canvas_width_u": 1080,
    "export_scale": 2,
    "delivery_width_css_px": 704,
    "max_height_css_px": 750,
    "caption_allowance_css_px": 80
  },
  "fonts": {
    "sans": {
      "family": "Pretendard",
      "stack": ["Pretendard", "Pretendard Variable", "Apple SD Gothic Neo", "Noto Sans KR", "Helvetica Neue", "Arial", "sans-serif"],
      "features": "\"ss06\" 1",
      "weights": [400, 600],
      "license": "SIL OFL 1.1",
      "version": "1.3.9"
    },
    "mono": {
      "family": "JetBrains Mono",
      "stack": ["JetBrains Mono", "IBM Plex Mono", "ui-monospace", "Menlo", "monospace"],
      "weights": [500],
      "license": "SIL OFL 1.1",
      "version": "2.304"
    },
    "math": {
      "engine": "mathjax-full 3.2.2 tex2svg, fontCache none, glyphs as paths",
      "ex_per_label_size": 0.53,
      "scale_after_ex_match": 0.94,
      "min_size_u": 13,
      "stroke_em": 0.012,
      "color": "ink"
    }
  },
  "type": {
    "panel_label": {"size_u": 15, "weight": 600, "color": "ink"},
    "node_label": {"size_u": 14, "weight": 600, "mono_weight": 500, "color": "ink"},
    "node_second_line": {"size_u": 12.5, "weight": 400, "color": "ink_2"},
    "edge_label": {"size_u": 12.5, "weight": 400, "color": "ink_2"},
    "annotation": {"size_u": 12, "weight": 400, "color": "ink_2"},
    "micro_caps": {"size_u": 11, "weight": 600, "tracking_em": 0.06, "color": "ink_2", "latin_only": true},
    "min_size_u": 12,
    "min_size_micro_caps_u": 11,
    "two_line_baseline_gap_u": 19,
    "advance_em_estimate": {"hangul": 0.864, "latin_sans": 0.55, "mono": 0.6}
  },
  "themes": {
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F4F3F1",
      "ink": "#2C2C2B",
      "ink_2": "#5F5E5B",
      "line": "#8E8B86",
      "guide": "#D4D3CF",
      "hues": {
        "blue": {"stroke": "#2769B7", "fill": "#E5F1FF", "text": "#1E5BA1"},
        "vermillion": {"stroke": "#C55123", "fill": "#FFEBE4", "text": "#A63C0C"},
        "magenta": {"stroke": "#C673A3", "fill": "#FEEAF2", "text": "#943569"}
      },
      "categorical": ["#0072B2", "#D55E00", "#009E73", "#CC79A7", "#E69F00", "#56B4E9", "#2C2C2B"]
    },
    "dark": {
      "bg": "#191919",
      "surface": "#252524",
      "ink": "#F0EFED",
      "ink_2": "#C4C2BD",
      "line": "#7D7A75",
      "guide": "#5F5E59",
      "hues": {
        "blue": {"stroke": "#75AEF5", "fill": "#1C2F46", "text": "#92C1FD"},
        "vermillion": {"stroke": "#ED845B", "fill": "#432519", "text": "#F9A782"},
        "magenta": {"stroke": "#B26191", "fill": "#412331", "text": "#F1ACCC"}
      },
      "categorical": ["#56B4E9", "#ED845B", "#3FBF93", "#E08FC0", "#E69F00", "#9CCBF0", "#F0EFED"]
    }
  },
  "stroke": {
    "guide_u": 1.0,
    "outline_u": 1.25,
    "edge_u": 1.5,
    "emphasis_u": 2.25,
    "allowed_u": [1.0, 1.25, 1.5, 2.25]
  },
  "arrowhead": {
    "shape": "open chevron, round join and cap, stroke equal to the edge",
    "length_u": "4 + 4.5 * stroke",
    "half_width_ratio": 0.4,
    "tip": "touches the target boundary"
  },
  "dash": {
    "dashed": "5 4",
    "dotted": "0 3",
    "dotted_linecap": "round"
  },
  "junction_dot_radius_per_stroke": 1.6,
  "operator_radius_u": 9,
  "radius_u": {
    "cell": 0,
    "tensor": 2,
    "chip": 4,
    "node": 6,
    "node_tall": 8,
    "container": 12,
    "max_ratio_of_height": 0.2
  },
  "spacing_u": {
    "unit": 4,
    "scale": [4, 8, 12, 16, 24, 32],
    "node_padding_x": 12,
    "node_padding_y": 8,
    "node_height_one_line": 36,
    "node_height_two_line": 52,
    "sibling_gap": 16,
    "group_gap": [24, 32],
    "container_padding": 16,
    "canvas_margin": 16,
    "edge_label_gap": 6,
    "edge_label_gap_from_arrowhead": 8
  },
  "limits": {
    "text_contrast_min": 4.5,
    "graphic_contrast_min": 3.0,
    "guide_apca_lc_min": 15,
    "chroma_area_max": 0.05,
    "semantic_hues_per_document_max": 3,
    "accents_per_figure_default": 1
  }
}
